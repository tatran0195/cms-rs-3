{
  "name": "cms-rs",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "bun run build:packages && bun --filter @cms/studio build",
    "build:packages": "bun --filter \"./packages/*\" build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter=@cms/e2e run test",
    "test:e2e:pages": "bun --filter=@cms/e2e run test tests/pages/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome check --write --unsafe --max-diagnostics=none .",
    "knip": "knip",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\"",
    "export:types": "cargo test -p cms-entity --test export_ts_bindings",
    "clean": "bun --filter '*' clean"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001814",
    "markdownlint-cli2": "^0.23.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "knip": "^6.39.0",
    "react-doctor": "^0.9.17",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.4",
    "unrun": "^0.3.1"
  }
}
